@admin.callback_query(F.data.startswith('pub_channel_'))
async def handle_pub_channel_select(callback: CallbackQuery, state: FSMContext):
    """Выбор канала публикации."""
    try:
        publisher_id = int(callback.data.replace('pub_channel_', ''))
    except ValueError:
        await callback.answer('❌ Ошибка выбора', show_alert=True)
        return

    await callback.answer()
    await state.update_data(publisher_channel_id=publisher_id)

    # Получаем название канала для подтверждения
    async with get_database_service().session_context() as session:
        factory = RepositoryFactory(session)
        publishers_repo = factory.publishers()
        publisher = await publishers_repo.get_by_id(publisher_id)

    data = await state.get_data()
    description = data.get('description', '')

    keyboard = InlineKeyboardMarkup(
        inline_keyboard=[
            [
                InlineKeyboardButton(text='⏰ Запустить сейчас', callback_data='direct_now'),
            ],
            [
                InlineKeyboardButton(text='🕐 К выбору времени', callback_data='direct_scheduled'),
            ],
            [
                InlineKeyboardButton(text='🔁 Периодическая', callback_data='direct_recurring'),
            ],
            [
                InlineKeyboardButton(text='🔙 Изменить канал', callback_data='pub_change_channel'),
            ],
        ]
    )

    try:

        await callback.message.edit_text(

        "✅ <b>Канал выбран</b>\n\n"
        f"Канал: {publisher.title if publisher else 'Неизвестно'}\n"
        "Описание: " + description[:100] + ('...' if len(description) > 100 else '') + "\n\n"
        "Выберите тип выполнения:",
        parse_mode='HTML',
        reply_markup=keyboard
    )

    except Exception:

        await callback.message.answer(

        "✅ <b>Канал выбран</b>\n\n"
        f"Канал: {publisher.title if publisher else 'Неизвестно'}\n"
        "Описание: " + description[:100] + ('...' if len(description) > 100 else '') + "\n\n"
        "Выберите тип выполнения:",
        parse_mode='HTML',
        reply_markup=keyboard
    )
        "✅ <b>Канал выбран</b>\n\n"
        f"Канал: {publisher.title if publisher else 'Неизвестно'}\n"
        "Описание: " + description[:100] + ('...' if len(description) > 100 else '') + "\n\n"
        "Выберите тип выполнения:",
        parse_mode='HTML',
        reply_markup=keyboard
    )


@admin.callback_query(F.data == 'pub_change_channel')
async def handle_pub_change_channel(callback: CallbackQuery, state: FSMContext):
    """Вернуться к выбору канала."""
    # Получаем список каналов
    async with get_database_service().session_context() as session:
        factory = RepositoryFactory(session)
        publishers_repo = factory.publishers()
        publishers = await publishers_repo.get_all(active_only=True)

    if not publishers:
        await callback.answer('Нет доступных каналов', show_alert=True)
        return

    # Формируем клавиатуру с каналами
    keyboard_buttons = []
    for pub in publishers[:10]:
        keyboard_buttons.append([
            InlineKeyboardButton(text=f'📢 {pub.title}', callback_data=f'pub_channel_{pub.id}'),
        ])
    keyboard_buttons.append([
        InlineKeyboardButton(text='⏭️ Пропустить (без канала)', callback_data='pub_skip'),
    ])
    keyboard_buttons.append([
        InlineKeyboardButton(text='🔙 Назад', callback_data='task_add_direct'),
    ])

    keyboard = InlineKeyboardMarkup(inline_keyboard=keyboard_buttons)

    await callback.answer()
    try:
        await callback.message.edit_text(

        "📢 <b>Выберите канал публикации</b>\n\n"
        "Канал будет указан в задаче (опционально):",
        parse_mode='HTML',
        reply_markup=keyboard
    )
    except Exception:
        await callback.message.answer(

        "📢 <b>Выберите канал публикации</b>\n\n"
        "Канал будет указан в задаче (опционально):",
        parse_mode='HTML',
        reply_markup=keyboard
    )
        "📢 <b>Выберите канал публикации</b>\n\n"
        "Канал будет указан в задаче (опционально):",
        parse_mode='HTML',
        reply_markup=keyboard
    )


