    )


@admin.message(StateFilter('TaskStates.editing_description'))
async def handle_edit_description(message: Message, state: FSMContext):
    """Обработка нового описания задачи."""
    if not await check_admin_access(message):
        return

    data = await state.get_data()
    task_id = data.get('editing_task_id')

    async with get_database_service().session_context() as session:
        factory = RepositoryFactory(session)
        task_repo = factory.tasks()

        await task_repo.update_task(task_id, description=message.text)

    await message.answer(f"✅ Описание обновлено!")
    await state.clear()


@admin.callback_query(F.data.startswith('edit_pub_select_'))
async def handle_edit_pub_select(callback: CallbackQuery, state: FSMContext):
    """Выбор канала при редактировании задачи."""
    try:
        publisher_id = int(callback.data.replace('edit_pub_select_', ''))
    except ValueError:
        await callback.answer('❌ Ошибка выбора', show_alert=True)
        return

    stored_data = await state.get_data()
    task_id = stored_data.get('editing_task_id')

    if not task_id:
        await callback.answer('❌ Ошибка: задача не выбрана', show_alert=True)
        return

    async with get_database_service().session_context() as session:
        factory = RepositoryFactory(session)
        task_repo = factory.tasks()

        await task_repo.update_task(task_id, publisher_channel_id=publisher_id)

    # Получаем название канала для подтверждения
    publishers_repo = factory.publishers()
    pub = await publishers_repo.get_by_id(publisher_id)

    await callback.answer(f"✅ Канал '{pub.title if pub else 'выбран'}' установлен!", show_alert=True)
    await callback.message.delete()

    # Показываем меню редактирования заново (передаём task_id из состояния)
    await show_task_edit_menu(callback, state, task_id)


@admin.callback_query(F.data == 'edit_pub_skip')
async def handle_edit_pub_skip(callback: CallbackQuery, state: FSMContext):
    """Пропустить выбор канала при редактировании."""
    stored_data = await state.get_data()
    task_id = stored_data.get('editing_task_id')

    if not task_id:
        await callback.answer('❌ Ошибка: задача не выбрана', show_alert=True)
        return

    async with get_database_service().session_context() as session:
        factory = RepositoryFactory(session)
        task_repo = factory.tasks()

        await task_repo.update_task(task_id, publisher_channel_id=None)

    await callback.answer('✅ Канал сброшен!', show_alert=True)
    await callback.message.delete()

    # Показываем меню редактирования заново
    await task_edit_callback(callback, state)


@admin.message(StateFilter('TaskStates.editing_scheduled_at'))
async def handle_edit_scheduled_at(message: Message, state: FSMContext):
    """Обработка нового времени задачи."""
    if not await check_admin_access(message):
        return

    try:
        scheduled_at = datetime.strptime(message.text, '%Y-%m-%d %H:%M')
    except ValueError:
        await message.answer('❌ Неверный формат. Используйте YYYY-MM-DD HH:MM')
        return

    # Проверяем, чтобы время не было в прошлом
    if scheduled_at <= datetime.now():
        await message.answer(
            '❌ Время не может быть в прошлом.\n\n'
            'Пожалуйста, укажите будущее время.'
        )
        return

    data = await state.get_data()
    task_id = data.get('editing_task_id')

    async with get_database_service().session_context() as session:
        factory = RepositoryFactory(session)
        task_repo = factory.tasks()

        await task_repo.update_task(task_id, scheduled_at=scheduled_at)

    await message.answer(f"✅ Время обновлено на {scheduled_at.strftime('%Y-%m-%d %H:%M')}!")
    await state.clear()


@admin.message(StateFilter('TaskStates.editing_recurrence'))
async def handle_edit_recurrence(message: Message, state: FSMContext):
    """Обработка новой периодичности задачи."""
    if not await check_admin_access(message):
        return

    try:
        pattern = int(message.text)
        if pattern < 1:
            raise ValueError()
    except ValueError:
        await message.answer('❌ Неверный формат. Отправьте число дней (минимум 1).')
        return

    data = await state.get_data()
    task_id = data.get('editing_task_id')

    async with get_database_service().session_context() as session:
        factory = RepositoryFactory(session)
        task_repo = factory.tasks()

        # Получаем задачу для сохранения оригинального описания
        task = await task_repo.get(task_id)
        if task:
            # Сохраняем оригинальное описание, добавляя информацию о периодичности
            original_desc = task.description or ''

            # Если описание уже содержит информацию о периодичности, удаляем её
            import re
            clean_desc = re.sub(r'\s*\(каждые \d+ дн\.\)|\(ежедневно\)', '', original_desc).strip()

            # Формируем новое описание с обновлённой периодичностью
            if task.task_type == 'direct_generation':
                # Для прямой генерации сохраняем оригинальное описание
                new_description = f'{clean_desc} (каждые {pattern} дн.)' if clean_desc else f'Периодическая прямая генерация (каждые {pattern} дн.)'
            elif task.task_type == 'scheduled_processing':
                # Для плановой обработки сохраняем оригинальное описание
                new_description = f'{clean_desc} (каждые {pattern} дн.)' if clean_desc else f'Периодическая плановая обработка (каждые {pattern} дн.)'
            else:
                new_description = original_desc

            await task_repo.update_task(
                task_id,
                recurring=True,
                recurrence_pattern=pattern,
                description=new_description,
            )

    await message.answer(f"✅ Периодичность обновлена: каждые {pattern} дн.!")
    await state.clear()


