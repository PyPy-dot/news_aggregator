    """Подтверждение отмены задачи."""
    # Извлекаем task_id из callback data вида 'task_cancel_123'
    task_id_str = callback.data.replace('task_cancel_', '')
    try:
        task_id = int(task_id_str)
    except ValueError:
        await callback.answer('❌ Ошибка: неверный ID задачи', show_alert=True)
        return

    async with get_database_service().session_context() as session:
        factory = RepositoryFactory(session)
        task_repo = factory.tasks()
