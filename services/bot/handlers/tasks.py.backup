# =============================================================================
# Отмена задач (устарело — теперь кнопка "Назад")
# =============================================================================

@admin.message(Command('cancel'))
async def cancel_task(message: Message, state: FSMContext):
    """Отмена текущего состояния для задач (устарело)."""
    # Проверяем права администратора
    if not await check_admin_access(message):
        return

    current_state = await state.get_state()

    if not current_state or not current_state.startswith('TaskStates.'):
        return

    await state.clear()
    await message.answer('❌ Задача отменена.')
