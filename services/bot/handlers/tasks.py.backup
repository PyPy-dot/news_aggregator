@admin.message(StateFilter('TaskStates.waiting_for_direct_time'), F.text)
async def handle_direct_time(message: Message, state: FSMContext):
    """Обработка времени запуска для периодической прямой генерации."""
    if not await check_admin_access(message):
        return

    time_text = message.text.strip()

    # Парсим время
    try:
        if ':' in time_text:
            hour, minute = map(int, time_text.split(':'))
            if not (0 <= hour <= 23 and 0 <= minute <= 59):
                raise ValueError()
        else:
            raise ValueError()
    except ValueError:
        await message.answer('❌ Неверный формат. Используйте ЧЧ:ММ (например, 14:30)')
        return

    data = await state.get_data()
    description = data.get('description', '')
    pattern = data.get('direct_recurrence', 1)
    publisher_channel_id = data.get('publisher_channel_id')

    scheduled_time = datetime.now().replace(hour=hour, minute=minute, second=0, microsecond=0)

    async with get_database_service().session_context() as session:
        factory = RepositoryFactory(session)
        task_repo = factory.tasks()

        task = await task_repo.create_task(
            task_type='direct_generation',
            description=f'{description[:150]} (каждые {pattern} дн.)',  # Описание + периодичность
            post_id=None,
            scheduled_at=scheduled_time,
            recurring=True,
            recurrence_pattern=pattern,
            publisher_channel_id=publisher_channel_id,
        )

    channel_info = f"\nКанал: ID={publisher_channel_id}" if publisher_channel_id else ""

    await message.answer(
        f"✅ <b>Периодическая задача создана!</b>\n\n"
        f"ID задачи: {task.id}\n"
        f"Тип: Прямая генерация{channel_info}\n"
        f"Периодичность: каждые {pattern} дн.\n"
        f"Время запуска: {scheduled_time.strftime('%H:%M')}\n"
        f"Статус: {task.status}",
        parse_mode='HTML'
    )

    await state.clear()
    logger.info(f"📋 Создана периодическая задача прямой генерации: task_id={task.id}, pattern={pattern}, publisher_id={publisher_channel_id}")


