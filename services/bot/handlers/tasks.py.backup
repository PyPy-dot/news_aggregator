# Список задач
# =============================================================================

@admin.callback_query(F.data == 'task_list')
async def task_list_callback(callback: CallbackQuery):
    """Показать список всех задач (pending и active)."""
    # Проверяем права администратора
    if not await check_admin_access(callback):
        await callback.answer('❌ У вас нет прав для этой команды', show_alert=True)
        return

    async with get_database_service().session_context() as session:
        factory = RepositoryFactory(session)
        task_repo = factory.tasks()

        # Показываем только задачи со статусами pending и active
        tasks = await task_repo.get_pending_and_active_tasks(limit=20)

    if not tasks:
        await callback.answer('Нет активных задач', show_alert=True)
        return

    text = "📋 <b>Активные задачи:</b>\n\n"
    for task in tasks:
        status_icon = {'pending': '⏳', 'active': '▶️'}.get(task.status, '❓')
        recurring_icon = '🔁' if task.recurring else ''
        text += f"{status_icon} <b>ID={task.id}</b> | {task.task_type} {recurring_icon}\n"
        text += f"   Описание: {task.description[:40]}{'...' if len(task.description) > 40 else ''}\n"
        if task.post_id:
            text += f"   Пост ID: {task.post_id}\n"
        if task.news_id:
            text += f"   Новость ID: {task.news_id}\n"
        if task.recurrence_pattern:
            text += f"   Периодичность: каждые {task.recurrence_pattern} дн.\n"
        text += f"   Статус: {task.status}\n\n"

    keyboard = InlineKeyboardMarkup(
        inline_keyboard=[
            [
                InlineKeyboardButton(text='🔙 Назад к задачам', callback_data='task_back_to_menu'),
            ],
        ]
    )

    await callback.answer()

    # Редактируем сообщение вместо создания нового
    try:
        await callback.message.edit_text(
text, parse_mode='HTML', reply_markup=keyboard)
    except Exception:
        await callback.message.answer(
text, parse_mode='HTML', reply_markup=keyboard)text, parse_mode='HTML', reply_markup=keyboard)
