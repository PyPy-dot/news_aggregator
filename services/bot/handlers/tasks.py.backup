"""
Хендлеры для управления задачами (админка).

Прямая генерация новостей, плановая обработка, CRUD задач.

Изменения v3.1.8:
- Два типа задач: Прямая генерация и Плановая обработка
- Обе задачи могут быть разовыми или периодическими
- Плановая обработка НЕ использует Analyst (уже выполнил работу на этапе категоризации)
- Выбор времени запуска задачи (не только утро/вечер)
- Кнопка "Назад" на всех этапах вместо /cancel
- Исправлена ошибка с правами для "Назад к задачам"
- Унифицирована терминология: "Внеплановая обработка" → "Плановая обработка"
"""

import logging
from datetime import datetime, timedelta
from aiogram import F, Router
from aiogram.types import Message, CallbackQuery, InlineKeyboardMarkup, InlineKeyboardButton
from aiogram.filters import Command, StateFilter
from aiogram.fsm.context import FSMContext

from services.bot.handlers.router import admin
from services.bot.handlers.access import check_admin_access

from database import RepositoryFactory
from services.database import get_database_service

logger = logging.getLogger(__name__)


# =============================================================================
# Главное меню задач
# =============================================================================

@admin.message(Command('tasks'))
@admin.message(F.text == '📝 Задачи')
async def tasks_menu(message: Message):
    """
    Главное меню управления задачами.
    """
    if not await check_admin_access(message):
        return

    keyboard = InlineKeyboardMarkup(
        inline_keyboard=[
            [
                InlineKeyboardButton(text='➕ Добавить задачу', callback_data='task_add'),
            ],
            [
                InlineKeyboardButton(text='✏️ Изменить задачу', callback_data='task_edit_list'),
            ],
            [
                InlineKeyboardButton(text='🗑️ Удалить задачу', callback_data='task_delete_list'),
            ],
            [
                InlineKeyboardButton(text='📋 Список задач', callback_data='task_list'),
            ],
            [
                InlineKeyboardButton(text='🔙 Назад', callback_data='back_to_admin_menu'),
            ],
        ]
    )

    await message.answer(
        "📝 <b>Управление задачами</b>\n\n"
        "Выберите действие:",
        parse_mode='HTML',
        reply_markup=keyboard
    )


# =============================================================================
# Добавление задачи
# =============================================================================

@admin.callback_query(F.data == 'task_add')
async def task_add_menu(callback: CallbackQuery):
    """
    Меню выбора типа добавляемой задачи.
    """
    # Проверяем права администратора
    if not await check_admin_access(callback):
        await callback.answer('❌ У вас нет прав для этой команды', show_alert=True)
        return

    await callback.answer()

    keyboard = InlineKeyboardMarkup(
        inline_keyboard=[
            [
                InlineKeyboardButton(text='✍️ Прямая генерация', callback_data='task_add_direct'),
            ],
            [
                InlineKeyboardButton(text='🔄 Плановая обработка', callback_data='task_add_scheduled'),
            ],
            [
                InlineKeyboardButton(text='🔙 Назад к задачам', callback_data='task_back_to_menu'),
            ],
        ]
    )

    # Редактируем сообщение вместо создания нового
    try:
        await callback.message.edit_text(
            "➕ <b>Добавление задачи</b>\n\n"
            "Выберите тип задачи:\n\n"
            "✍️ <b>Прямая генерация</b> — создание новости по описанию\n"
            "🔄 <b>Плановая обработка</b> — обработка ожидающих новостей",
            parse_mode='HTML',
            reply_markup=keyboard
        )
            "➕ <b>Добавление задачи</b>\n\n"
            "Выберите тип задачи:\n\n"
            "✍️ <b>Прямая генерация</b> — создание новости по описанию\n"
            "🔄 <b>Плановая обработка</b> — обработка ожидающих новостей",
            parse_mode='HTML',
            reply_markup=keyboard
        )


@admin.callback_query(F.data == 'task_back_to_menu')
async def task_back_to_menu_callback(callback: CallbackQuery):
    """
    Вернуться в меню задач из добавления задачи.

    Проверка прав не требуется — кнопка доступна только из меню задач,
    где пользователь уже прошёл проверку прав.
    """
    await callback.answer()

    # Показываем меню задач напрямую (без вызова tasks_menu, который проверяет права)
    keyboard = InlineKeyboardMarkup(
        inline_keyboard=[
            [
                InlineKeyboardButton(text='➕ Добавить задачу', callback_data='task_add'),
            ],
            [
                InlineKeyboardButton(text='✏️ Изменить задачу', callback_data='task_edit_list'),
            ],
            [
                InlineKeyboardButton(text='🗑️ Удалить задачу', callback_data='task_delete_list'),
            ],
            [
                InlineKeyboardButton(text='📋 Список задач', callback_data='task_list'),
            ],
            [
                InlineKeyboardButton(text='🔙 Назад', callback_data='back_to_admin_menu'),
            ],
        ]
    )

    # Удаляем текущее сообщение вместо редактирования
    try:
        await callback.message.delete()
    except Exception:
        pass

    try:

        await callback.message.edit_text(

        "📝 <b>Управление задачами</b>\n\n"
        "Выберите действие:",
        parse_mode='HTML',
        reply_markup=keyboard
    )

    except Exception:

        await callback.message.answer(

        "📝 <b>Управление задачами</b>\n\n"
        "Выберите действие:",
        parse_mode='HTML',
        reply_markup=keyboard
    )
        "📝 <b>Управление задачами</b>\n\n"
        "Выберите действие:",
        parse_mode='HTML',
        reply_markup=keyboard
    )


@admin.callback_query(F.data == 'task_add_direct')
