        "Вы уверены? Это действие нельзя отменить.",
        parse_mode='HTML',
        reply_markup=keyboard
    )
    except Exception:
        await callback.message.answer(

        f"❌ <b>Отмена задачи ID={task.id}</b>\n\n"
        f"Тип: {task.task_type}\n"
        f"Описание: {task.description[:50]}{'...' if len(task.description) > 50 else ''}\n\n"
        "Вы уверены? Это действие нельзя отменить.",
        parse_mode='HTML',
        reply_markup=keyboard
    )
        f"❌ <b>Отмена задачи ID={task.id}</b>\n\n"
        f"Тип: {task.task_type}\n"
        f"Описание: {task.description[:50]}{'...' if len(task.description) > 50 else ''}\n\n"
        "Вы уверены? Это действие нельзя отменить.",
        parse_mode='HTML',
        reply_markup=keyboard
    )


@admin.callback_query(F.data.startswith('task_cancel_confirm_'))
async def task_cancel_execute_callback(callback: CallbackQuery):
    """Выполнение отмены задачи."""
    task_id = int(callback.data.replace('task_cancel_confirm_', ''))

    async with get_database_service().session_context() as session:
        factory = RepositoryFactory(session)
        task_repo = factory.tasks()

        canceled = await task_repo.mark_canceled(task_id)

    if canceled:
        await callback.answer('✅ Задача отменена', show_alert=True)
        await callback.message.delete()
        logger.info(f"🚫 Отменена задача: task_id={task_id}")
    else:
        await callback.answer('❌ Ошибка: задача не найдена', show_alert=True)


@admin.callback_query(F.data.startswith('edit_field_'))
async def edit_field_callback(callback: CallbackQuery, state: FSMContext):
    """Начало редактирования поля задачи."""
    # Проверка прав не требуется — кнопка доступна только из меню редактирования
    field = callback.data.replace('edit_field_', '')
    data = await state.get_data()
    task_id = data.get('editing_task_id')

    if not task_id:
        await callback.answer('❌ Ошибка: задача не выбрана', show_alert=True)
        return

    # Обработка выбора канала — отдельный хендлер со списком
    if field == 'publisher':
        async with get_database_service().session_context() as session:
            factory = RepositoryFactory(session)
            publishers_repo = factory.publishers()
            publishers = await publishers_repo.get_all(active_only=True)

        if not publishers:
            await callback.answer('Нет доступных каналов', show_alert=True)
            return

        keyboard_buttons = []
        for pub in publishers[:10]:
            keyboard_buttons.append([
                InlineKeyboardButton(text=f'📢 {pub.title}', callback_data=f'edit_pub_select_{pub.id}'),
            ])
        keyboard_buttons.append([
            InlineKeyboardButton(text='⏭️ Не выбирать канал', callback_data='edit_pub_skip'),
        ])
        keyboard_buttons.append([
            InlineKeyboardButton(text='🔙 Назад к редактированию', callback_data=f'task_edit_{task_id}'),
        ])

        keyboard = InlineKeyboardMarkup(inline_keyboard=keyboard_buttons)

        await callback.answer()
        try:
            await callback.message.edit_text(

            "📢 <b>Выберите канал публикации</b>\n\n"
            "Канал будет указан в задаче (опционально):",
            parse_mode='HTML',
            reply_markup=keyboard
        )
        except Exception:
            await callback.message.answer(

            "📢 <b>Выберите канал публикации</b>\n\n"
            "Канал будет указан в задаче (опционально):",
            parse_mode='HTML',
            reply_markup=keyboard
        )
            "📢 <b>Выберите канал публикации</b>\n\n"
            "Канал будет указан в задаче (опционально):",
            parse_mode='HTML',
            reply_markup=keyboard
        )
        return

    # Для остальных полей — ввод текста
    await state.set_state(f'TaskStates.editing_{field}')
    await callback.answer()

    field_names = {
        'description': 'Описание',
        'scheduled_at': 'Время (формат: YYYY-MM-DD HH:MM)',
        'recurrence': 'Периодичность в днях (число)',
    }

    keyboard = InlineKeyboardMarkup(
        inline_keyboard=[
            [
                InlineKeyboardButton(text='🔙 Назад к редактированию', callback_data=f'task_edit_{task_id}'),
            ],
        ]
    )

    try:

        await callback.message.edit_text(

        f"✏️ <b>Редактирование: {field_names.get(field, field)}</b>\n\n"
        f"Отправьте новое значение.\n\n"
        "Для отмены нажмите кнопку ниже:",
        parse_mode='HTML',
        reply_markup=keyboard
    )

    except Exception:

        await callback.message.answer(

        f"✏️ <b>Редактирование: {field_names.get(field, field)}</b>\n\n"
        f"Отправьте новое значение.\n\n"
        "Для отмены нажмите кнопку ниже:",
        parse_mode='HTML',
        reply_markup=keyboard
    )
        f"✏️ <b>Редактирование: {field_names.get(field, field)}</b>\n\n"
        f"Отправьте новое значение.\n\n"
        "Для отмены нажмите кнопку ниже:",
        parse_mode='HTML',
