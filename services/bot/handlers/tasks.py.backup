        parse_mode='HTML',
        reply_markup=keyboard
    )
    except Exception:
        await callback.message.answer(

        "🕐 <b>Время запуска</b>\n\n"
        "Отправьте время запуска в формате:\n"
        "<b>ЧЧ:ММ</b> (например, 14:30)",
        parse_mode='HTML',
        reply_markup=keyboard
    )
        "🕐 <b>Время запуска</b>\n\n"
        "Отправьте время запуска в формате:\n"
        "<b>ЧЧ:ММ</b> (например, 14:30)",
        parse_mode='HTML',
        reply_markup=keyboard
    )


@admin.message(StateFilter('TaskStates.waiting_for_scheduled_time'), F.text)
async def handle_scheduled_time(message: Message, state: FSMContext):
    """Обработка времени запуска для периодической плановой обработки."""
    if not await check_admin_access(message):
        return

    time_text = message.text.strip()

    # Парсим время
    try:
        if ':' in time_text:
            hour, minute = map(int, time_text.split(':'))
            if not (0 <= hour <= 23 and 0 <= minute <= 59):
                raise ValueError()
        else:
            raise ValueError()
    except ValueError:
        await message.answer('❌ Неверный формат. Используйте ЧЧ:ММ (например, 14:30)')
        return

    data = await state.get_data()
    pattern = data.get('scheduled_recurrence', 1)

    # Если время уже прошло, устанавливаем на следующий день
    scheduled_time = datetime.now().replace(hour=hour, minute=minute, second=0, microsecond=0)
    if scheduled_time <= datetime.now():
        scheduled_time += timedelta(days=1)

    async with get_database_service().session_context() as session:
        factory = RepositoryFactory(session)
        task_repo = factory.tasks()

        task = await task_repo.create_task(
            task_type='scheduled_processing',
            description=f'Периодическая плановая обработка (каждые {pattern} дн.)',
            news_id=None,
            scheduled_at=scheduled_time,
            recurring=True,
            recurrence_pattern=pattern,
        )

    await message.answer(
        f"✅ <b>Периодическая задача создана!</b>\n\n"
        f"ID задачи: {task.id}\n"
        f"Тип: Плановая обработка\n"
        f"Периодичность: каждые {pattern} дн.\n"
        f"Время запуска: {scheduled_time.strftime('%H:%M')}\n"
        f"Статус: {task.status}",
        parse_mode='HTML'
    )

    await state.clear()
    logger.info(f"📋 Создана периодическая задача плановой обработки: task_id={task.id}, pattern={pattern}")


