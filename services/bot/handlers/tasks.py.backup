@admin.callback_query(F.data == 'task_edit_list')
async def task_edit_list_callback(callback: CallbackQuery):
    """Список задач для редактирования."""
    # Проверяем права администратора
    if not await check_admin_access(callback):
        await callback.answer('❌ У вас нет прав для этой команды', show_alert=True)
        return

    async with get_database_service().session_context() as session:
        factory = RepositoryFactory(session)
        task_repo = factory.tasks()

        # Показываем только задачи со статусом pending (редактирование разрешено только для них)
        tasks = await task_repo.get_pending_tasks(limit=20)

    if not tasks:
        await callback.answer('Нет задач для редактирования (доступны только задачи со статусом pending)', show_alert=True)
        return

    keyboard_buttons = []
    for task in tasks[:10]:
        keyboard_buttons.append([
            InlineKeyboardButton(
                text=f'ID={task.id} | {task.task_type[:20]}',
                callback_data=f'task_edit_{task.id}'
            )
        ])
    keyboard_buttons.append([
        InlineKeyboardButton(text='🔙 Назад к задачам', callback_data='task_back_to_menu')
    ])

    keyboard = InlineKeyboardMarkup(inline_keyboard=keyboard_buttons)

    await callback.answer()

    # Редактируем сообщение вместо создания нового
    try:
        await callback.message.edit_text(

            "✏️ <b>Редактирование задачи</b>\n\n"
            "Выберите задачу для редактирования (только pending):\n"
            "<i>Задачи в работе (active) редактировать нельзя</i>",
            parse_mode='HTML',
            reply_markup=keyboard
        )
    except Exception:
        await callback.message.answer(

            "✏️ <b>Редактирование задачи</b>\n\n"
            "Выберите задачу для редактирования (только pending):\n"
            "<i>Задачи в работе (active) редактировать нельзя</i>",
            parse_mode='HTML',
            reply_markup=keyboard
        )
            "✏️ <b>Редактирование задачи</b>\n\n"
            "Выберите задачу для редактирования (только pending):\n"
            "<i>Задачи в работе (active) редактировать нельзя</i>",
            parse_mode='HTML',
            reply_markup=keyboard
        )
            "✏️ <b>Редактирование задачи</b>\n\n"
            "Выберите задачу для редактирования (только pending):\n"
            "<i>Задачи в работе (active) редактировать нельзя</i>",
            parse_mode='HTML',
            reply_markup=keyboard
        )


async def show_task_edit_menu(callback: CallbackQuery, state: FSMContext, task_id: int) -> None:
    """
    Показать меню редактирования задачи.

    Args:
        callback: Callback query
        state: FSM состояние
        task_id: ID задачи для редактирования
    """
    await state.update_data(editing_task_id=task_id)

    async with get_database_service().session_context() as session:
        factory = RepositoryFactory(session)
        task_repo = factory.tasks()
        task = await task_repo.get(task_id)

    if not task:
        await callback.answer('❌ Задача не найдена', show_alert=True)
        return

    # Проверяем статус задачи — редактирование только для pending
    if task.status != 'pending':
        keyboard_buttons = [
            [
                InlineKeyboardButton(text='🔙 Назад к списку', callback_data='task_edit_list'),
            ],
        ]
        keyboard = InlineKeyboardMarkup(inline_keyboard=keyboard_buttons)

        await callback.answer()
        try:
            await callback.message.edit_text(

            f"⚠️ <b>Задача ID={task.id} не может быть отредактирована</b>\n\n"
            f"Тип: {task.task_type}\n"
            f"Статус: <b>{task.status}</b>\n\n"
            f"<i>Редактирование разрешено только для задач со статусом pending</i>",
            parse_mode='HTML',
            reply_markup=keyboard
        )
        except Exception:
            await callback.message.answer(

            f"⚠️ <b>Задача ID={task.id} не может быть отредактирована</b>\n\n"
            f"Тип: {task.task_type}\n"
            f"Статус: <b>{task.status}</b>\n\n"
            f"<i>Редактирование разрешено только для задач со статусом pending</i>",
            parse_mode='HTML',
            reply_markup=keyboard
        )
            f"⚠️ <b>Задача ID={task.id} не может быть отредактирована</b>\n\n"
            f"Тип: {task.task_type}\n"
            f"Статус: <b>{task.status}</b>\n\n"
            f"<i>Редактирование разрешено только для задач со статусом pending</i>",
            parse_mode='HTML',
            reply_markup=keyboard
        )
        return

    # Формируем кнопки для pending задач
    keyboard_buttons = []

    # Описание редактируем только для прямой генерации
    if task.task_type == 'direct_generation':
        keyboard_buttons.append([
            InlineKeyboardButton(text='✏️ Описание', callback_data='edit_field_description'),
        ])

    # Канал публикации редактируем только для прямой генерации
    if task.task_type == 'direct_generation':
        # Получаем название канала
        channel_name = "Не выбран"
        if task.publisher_channel_id:
            async with get_database_service().session_context() as session:
                factory = RepositoryFactory(session)
                publishers_repo = factory.publishers()
                pub = await publishers_repo.get_by_id(task.publisher_channel_id)
                if pub:
                    channel_name = pub.title

        keyboard_buttons.append([
            InlineKeyboardButton(text=f'📢 Канал: {channel_name[:20]}', callback_data='edit_field_publisher'),
        ])

    keyboard_buttons.append([
        InlineKeyboardButton(text='🕐 Время', callback_data='edit_field_scheduled_at'),
    ])
    keyboard_buttons.append([
        InlineKeyboardButton(text='🔁 Периодичность', callback_data='edit_field_recurrence'),
    ])

    # Кнопка отмены задачи
    keyboard_buttons.append([
        InlineKeyboardButton(text='❌ Отменить задачу', callback_data=f'task_cancel_{task.id}'),
    ])

    keyboard_buttons.append([
        InlineKeyboardButton(text='🔙 Назад к списку', callback_data='task_edit_list'),
    ])

    keyboard = InlineKeyboardMarkup(inline_keyboard=keyboard_buttons)

    await callback.answer()
    try:
        await callback.message.edit_text(

        f"✏️ <b>Редактирование задачи ID={task.id}</b>\n\n"
        f"Тип: {task.task_type}\n"
        f"Статус: {task.status}\n"
        f"Описание: {task.description}\n"
        f"Время: {task.scheduled_at.strftime('%Y-%m-%d %H:%M') if task.scheduled_at else 'Не указано'}\n"
        f"Периодическая: {'Да' if task.recurring else 'Нет'}\n"
        f"Периодичность: {task.recurrence_pattern or '-'} дн.\n\n"
        "Выберите поле для редактирования:",
        parse_mode='HTML',
        reply_markup=keyboard
    )
    except Exception:
        await callback.message.answer(

        f"✏️ <b>Редактирование задачи ID={task.id}</b>\n\n"
        f"Тип: {task.task_type}\n"
        f"Статус: {task.status}\n"
        f"Описание: {task.description}\n"
        f"Время: {task.scheduled_at.strftime('%Y-%m-%d %H:%M') if task.scheduled_at else 'Не указано'}\n"
        f"Периодическая: {'Да' if task.recurring else 'Нет'}\n"
        f"Периодичность: {task.recurrence_pattern or '-'} дн.\n\n"
        "Выберите поле для редактирования:",
        parse_mode='HTML',
        reply_markup=keyboard
    )
        f"✏️ <b>Редактирование задачи ID={task.id}</b>\n\n"
        f"Тип: {task.task_type}\n"
        f"Статус: {task.status}\n"
        f"Описание: {task.description}\n"
        f"Время: {task.scheduled_at.strftime('%Y-%m-%d %H:%M') if task.scheduled_at else 'Не указано'}\n"
        f"Периодическая: {'Да' if task.recurring else 'Нет'}\n"
