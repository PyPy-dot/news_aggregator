@admin.message(StateFilter('TaskStates.waiting_for_direct_scheduled_time'), F.text)
async def handle_direct_scheduled_time(message: Message, state: FSMContext):
    """Обработка времени для разовой генерации."""
    if not await check_admin_access(message):
        return

    time_text = message.text.strip()

    # Парсим дату и время
    try:
        scheduled_at = datetime.strptime(time_text, '%Y-%m-%d %H:%M')
        # Проверяем, чтобы время не было в прошлом
        if scheduled_at <= datetime.now():
            await message.answer('❌ Время не может быть в прошлом. Пожалуйста, укажите будущее время.')
            return
    except ValueError:
        await message.answer('❌ Неверный формат. Используйте YYYY-MM-DD HH:MM (например, 2026-08-10 14:30)')
        return

    data = await state.get_data()
    description = data.get('description', '')
    publisher_channel_id = data.get('publisher_channel_id')

    async with get_database_service().session_context() as session:
        factory = RepositoryFactory(session)
        task_repo = factory.tasks()

        task = await task_repo.create_task(
            task_type='direct_generation',
            description=description[:200],
            post_id=None,
            scheduled_at=scheduled_at,
            publisher_channel_id=publisher_channel_id,
        )

    channel_info = f"\nКанал: ID={publisher_channel_id}" if publisher_channel_id else ""

    await message.answer(
        f"✅ <b>Задача создана!</b>\n\n"
        f"ID задачи: {task.id}\n"
        f"Тип: Прямая генерация{channel_info}\n"
        f"Описание: {description[:100]}{'...' if len(description) > 100 else ''}\n"
        f"Запуск: {scheduled_at.strftime('%Y-%m-%d %H:%M')}\n"
        f"Статус: {task.status}",
        parse_mode='HTML'
    )

    await state.clear()
    logger.info(f"📋 Создана задача прямой генерации на {scheduled_at}: task_id={task.id}")


