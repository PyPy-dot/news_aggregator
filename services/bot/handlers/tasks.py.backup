        ]
    )

    try:
        await callback.message.edit_text(
            "✍️ <b>Прямая генерация новости</b>\n\n"
            "Отправьте описание новости (текст).\n"
            "📎 Можно прикрепить фото или видео.\n\n"
            "Для отмены нажмите кнопку ниже:",
            parse_mode='HTML',
            reply_markup=keyboard
        )
            "✍️ <b>Прямая генерация новости</b>\n\n"
            "Отправьте описание новости (текст).\n"
            "📎 Можно прикрепить фото или видео.\n\n"
            "Для отмены нажмите кнопку ниже:",
            parse_mode='HTML',
            reply_markup=keyboard
        )


@admin.message(StateFilter('TaskStates.waiting_for_description'), F.text)
async def handle_task_description(message: Message, state: FSMContext):
    """Обработка описания для прямой генерации."""
    if not await check_admin_access(message):
        return

    description = message.text.strip()

    # Сохраняем описание и проверяем медиа
    media_info = None
    if message.photo:
        media_info = {'type': 'photo', 'file_id': message.photo[-1].file_id}
    elif message.video:
        media_info = {'type': 'video', 'file_id': message.video.file_id}

    await state.update_data(description=description, media=media_info)

    # Получаем список каналов публикации
    async with get_database_service().session_context() as session:
        factory = RepositoryFactory(session)
        publishers_repo = factory.publishers()
        publishers = await publishers_repo.get_all(active_only=True)

    if not publishers:
        # Если нет каналов, пропускаем выбор и идём к типу выполнения
        keyboard = InlineKeyboardMarkup(
            inline_keyboard=[
                [
                    InlineKeyboardButton(text='⏰ Запустить сейчас', callback_data='direct_now'),
                ],
                [
                    InlineKeyboardButton(text='🔁 Периодическая', callback_data='direct_recurring'),
                ],
                [
                    InlineKeyboardButton(text='🔙 Назад', callback_data='task_add_direct'),
                ],
            ]
        )
        await message.answer(
            "🕐 <b>Выберите тип выполнения</b>\n\n"
            "Описание: " + description[:100] + ('...' if len(description) > 100 else '') + "\n\n"
            "Запустить сейчас или сделать периодической?",
            parse_mode='HTML',
            reply_markup=keyboard
        )
        return

    # Сохраняем описание и переходим к выбору канала
    await state.set_state('TaskStates.waiting_for_channel')

    # Формируем клавиатуру с каналами
    keyboard_buttons = []
    for pub in publishers[:10]:  # Максимум 10 каналов
        keyboard_buttons.append([
            InlineKeyboardButton(text=f'📢 {pub.title}', callback_data=f'pub_channel_{pub.id}'),
        ])

    # Добавляем специальные опции
    keyboard_buttons.append([
        InlineKeyboardButton(text='📤 Отправить через бота', callback_data='pub_via_bot'),
        InlineKeyboardButton(text='📢 Во все каналы', callback_data='pub_all_channels'),
    ])
    keyboard_buttons.append([
        InlineKeyboardButton(text='🔙 Назад', callback_data='task_add_direct'),
    ])

    keyboard = InlineKeyboardMarkup(inline_keyboard=keyboard_buttons)

    await message.answer(
        "📢 <b>Выберите канал публикации</b>\n\n"
        "Описание: " + description[:100] + ('...' if len(description) > 100 else '') + "\n\n"
        "Выберите канал или способ публикации:",
        parse_mode='HTML',
        reply_markup=keyboard
    )


@admin.callback_query(F.data == 'pub_via_bot')
async def handle_pub_via_bot(callback: CallbackQuery, state: FSMContext):
    """Отправить через бота (публикация от имени бота)."""
    await callback.answer()

    # publisher_channel_id = None означает публикацию через бота
    await state.update_data(publisher_channel_id=None)
    data = await state.get_data()
    description = data.get('description', '')

    keyboard = InlineKeyboardMarkup(
        inline_keyboard=[
            [
                InlineKeyboardButton(text='⏰ Запустить сейчас', callback_data='direct_now'),
            ],
            [
                InlineKeyboardButton(text='🕐 К выбору времени', callback_data='direct_scheduled'),
            ],
            [
                InlineKeyboardButton(text='🔁 Периодическая', callback_data='direct_recurring'),
            ],
            [
                InlineKeyboardButton(text='🔙 Назад', callback_data='task_add_direct'),
            ],
        ]
    )

    try:

        await callback.message.edit_text(

        "🕐 <b>Выберите тип выполнения</b>\n\n"
        "Описание: " + description[:100] + ('...' if len(description) > 100 else '') + "\n\n"
        "Публикация: <b>Через бота</b>\n\n"
        "Запустить сейчас, в указанное время или сделать периодической?",
        parse_mode='HTML',
        reply_markup=keyboard
    )

    except Exception:

        await callback.message.answer(

        "🕐 <b>Выберите тип выполнения</b>\n\n"
        "Описание: " + description[:100] + ('...' if len(description) > 100 else '') + "\n\n"
        "Публикация: <b>Через бота</b>\n\n"
        "Запустить сейчас, в указанное время или сделать периодической?",
        parse_mode='HTML',
        reply_markup=keyboard
    )
        "🕐 <b>Выберите тип выполнения</b>\n\n"
        "Описание: " + description[:100] + ('...' if len(description) > 100 else '') + "\n\n"
        "Публикация: <b>Через бота</b>\n\n"
        "Запустить сейчас, в указанное время или сделать периодической?",
        parse_mode='HTML',
        reply_markup=keyboard
    )


