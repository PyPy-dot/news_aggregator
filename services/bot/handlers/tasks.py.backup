@admin.callback_query(F.data == 'task_delete_list')
async def task_delete_list_callback(callback: CallbackQuery):
    """Список задач для удаления."""
    # Проверяем права администратора
    if not await check_admin_access(callback):
        await callback.answer('❌ У вас нет прав для этой команды', show_alert=True)
        return

    async with get_database_service().session_context() as session:
        factory = RepositoryFactory(session)
        task_repo = factory.tasks()

        tasks = await task_repo.get_all_tasks(limit=20)

    if not tasks:
        await callback.answer('Нет задач для удаления', show_alert=True)
        return

    keyboard_buttons = []
    for task in tasks[:10]:
        keyboard_buttons.append([
            InlineKeyboardButton(
                text=f'ID={task.id} | {task.task_type[:20]}',
                callback_data=f'task_delete_{task.id}'
            )
        ])
    keyboard_buttons.append([
        InlineKeyboardButton(text='🔙 Назад к задачам', callback_data='task_back_to_menu')
    ])

    keyboard = InlineKeyboardMarkup(inline_keyboard=keyboard_buttons)

    await callback.answer()

    # Редактируем сообщение вместо создания нового
    try:
        await callback.message.edit_text(

            "🗑️ <b>Удаление задачи</b>\n\n"
            "Выберите задачу для удаления:",
            parse_mode='HTML',
            reply_markup=keyboard
        )
    except Exception:
        await callback.message.answer(

            "🗑️ <b>Удаление задачи</b>\n\n"
            "Выберите задачу для удаления:",
            parse_mode='HTML',
            reply_markup=keyboard
        )
            "🗑️ <b>Удаление задачи</b>\n\n"
            "Выберите задачу для удаления:",
            parse_mode='HTML',
            reply_markup=keyboard
        )
            "🗑️ <b>Удаление задачи</b>\n\n"
            "Выберите задачу для удаления:",
            parse_mode='HTML',
            reply_markup=keyboard
        )


@admin.callback_query(F.data.startswith('task_delete_') & ~F.data.startswith('task_delete_confirm_'))
async def task_delete_confirm_callback(callback: CallbackQuery, state: FSMContext):
    """Подтверждение удаления задачи."""
    # Проверка прав не требуется — кнопка доступна только из списка задач
    # Извлекаем task_id из callback data вида 'task_delete_123'
    task_id_str = callback.data.replace('task_delete_', '')
    try:
        task_id = int(task_id_str)
    except ValueError:
        await callback.answer('❌ Ошибка: неверный ID задачи', show_alert=True)
        return

    keyboard = InlineKeyboardMarkup(
        inline_keyboard=[
            [
                InlineKeyboardButton(text='✅ Да, удалить', callback_data=f'task_delete_confirm_{task_id}'),
            ],
            [
                InlineKeyboardButton(text='🔙 Назад к списку', callback_data='task_delete_list'),
            ],
        ]
    )

    await callback.answer()
    try:
        await callback.message.edit_text(

        f"🗑️ <b>Удаление задачи ID={task_id}</b>\n\n"
        "Вы уверены? Это действие нельзя отменить.",
        parse_mode='HTML',
        reply_markup=keyboard
    )
    except Exception:
        await callback.message.answer(

        f"🗑️ <b>Удаление задачи ID={task_id}</b>\n\n"
        "Вы уверены? Это действие нельзя отменить.",
        parse_mode='HTML',
        reply_markup=keyboard
    )
        f"🗑️ <b>Удаление задачи ID={task_id}</b>\n\n"
        "Вы уверены? Это действие нельзя отменить.",
        parse_mode='HTML',
        reply_markup=keyboard
    )


@admin.callback_query(F.data.startswith('task_delete_confirm_'))
async def task_delete_execute_callback(callback: CallbackQuery):
    """Выполнение удаления задачи."""
    # Проверка прав не требуется — кнопка доступна только из подтверждения
    task_id = int(callback.data.replace('task_delete_confirm_', ''))

    async with get_database_service().session_context() as session:
        factory = RepositoryFactory(session)
        task_repo = factory.tasks()

        deleted = await task_repo.delete_task(task_id)

    if deleted:
        await callback.answer('✅ Задача удалена', show_alert=True)
        try:
            await callback.message.delete()
        except Exception:
            # Сообщение может быть уже удалено или изменено
            pass
        logger.info(f"🗑️ Удалена задача: task_id={task_id}")
    else:
        await callback.answer('❌ Ошибка: задача не найдена', show_alert=True)


