@admin.callback_query(F.data == 'direct_scheduled')
async def handle_direct_scheduled(callback: CallbackQuery, state: FSMContext):
    """Выбор времени для разовой генерации."""
    await callback.answer()
    await state.set_state('TaskStates.waiting_for_direct_scheduled_time')

    # Вычисляем завтрашнюю дату для примера
    tomorrow = datetime.now().replace(hour=12, minute=0, second=0, microsecond=0) + timedelta(days=1)
    tomorrow_str = tomorrow.strftime('%Y-%m-%d %H:%M')

    keyboard = InlineKeyboardMarkup(
        inline_keyboard=[
            [
                InlineKeyboardButton(text='🔙 Назад', callback_data='direct_type_selection'),
            ],
        ]
    )

    try:

        await callback.message.edit_text(

        "🕐 <b>Время запуска</b>\n\n"
        f"Отправьте дату и время в формате:\n"
        f"<b>YYYY-MM-DD HH:MM</b> (например, {tomorrow_str})\n\n"
        "Для отмены нажмите кнопку ниже:",
        parse_mode='HTML',
        reply_markup=keyboard
    )

    except Exception:

        await callback.message.answer(

        "🕐 <b>Время запуска</b>\n\n"
        f"Отправьте дату и время в формате:\n"
        f"<b>YYYY-MM-DD HH:MM</b> (например, {tomorrow_str})\n\n"
        "Для отмены нажмите кнопку ниже:",
        parse_mode='HTML',
        reply_markup=keyboard
    )
        "🕐 <b>Время запуска</b>\n\n"
