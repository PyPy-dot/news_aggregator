# =============================================================================
# News Aggregator — Environment Variables Example
# =============================================================================
# Скопируйте этот файл в .env и заполните значениями!
# cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Application Version
# -----------------------------------------------------------------------------
APP_VERSION=4.0.0

# -----------------------------------------------------------------------------
# База данных (PostgreSQL)
# -----------------------------------------------------------------------------
DB_USER=news
DB_PASSWORD=change_this_password_in_production
DB_NAME=news_aggregator

# -----------------------------------------------------------------------------
# Telegram Bot (получить в @BotFather)
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_PHONE_NUMBER=+79991234567

# -----------------------------------------------------------------------------
# Telegram Proxy (опционально, для обхода блокировок)
# -----------------------------------------------------------------------------
# Формат: socks5://hostname:port или http://hostname:port
# Пример: TELEGRAM_PROXY=socks5://127.0.0.1:1080
# TELEGRAM_PROXY=

# -----------------------------------------------------------------------------
# Telegram Session (для ListenerBot / UserBot)
# -----------------------------------------------------------------------------
# Session string для сохранения авторизации между запусками
# Получается после первой авторизации (логируется при запуске)
# TELEGRAM_SESSION_STRING=AgAB... (очень длинная строка)

# -----------------------------------------------------------------------------
# Admin (Telegram ID администратора)
# -----------------------------------------------------------------------------
ADMIN_ID=your_telegram_id_here

# -----------------------------------------------------------------------------
# 2FA (Двухфакторная аутентификация для Listener Bot)
# -----------------------------------------------------------------------------
# Включить 2FA для защиты авторизации Listener Bot
# LISTENER_2FA_ENABLED=true
#
# Провайдер 2FA: google или yandex
# - google — Google Authenticator (стандартный otpauth:// URI)
# - yandex — Яндекс.Ключ (специальный формат URI)
# LISTENER_2FA_PROVIDER=google
#
# Секретный ключ 2FA (генерируется автоматически при настройке через /2fa setup)
# LISTENER_2FA_SECRET=

# -----------------------------------------------------------------------------
# JWT Secret (для Web админки)
# -----------------------------------------------------------------------------
# Сгенерируйте случайную строку: openssl rand -hex 32
WEB_ADMIN_JWT_SECRET=change_this_to_random_secret_in_production

# -----------------------------------------------------------------------------
# LLM Providers (Fallback цепочка)
# -----------------------------------------------------------------------------
# Основной провайдер: ollama, openai, anthropic
LLM_PRIMARY_PROVIDER=ollama

# Ollama (локальный LLM)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# OpenAI API (fallback)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic API (fallback)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Fallback настройки
LLM_RETRY_ATTEMPTS=3
LLM_RETRY_DELAY_SECONDS=2
LLM_FALLBACK_ENABLED=true

# -----------------------------------------------------------------------------
# ChromaDB (векторный поиск)
# -----------------------------------------------------------------------------
CHROMA_HOST=http://chromadb:8000

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
