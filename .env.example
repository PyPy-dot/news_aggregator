# Telegram Bot
BOT_TOKEN=your_bot_token_here

# Ключ шифрования для user_id (ОБЯЗАТЕЛЬНО: мин. 32 символа)
# Сгенерируйте случайный ключ: python -c "import secrets; print(secrets.token_hex(32))"
ENCRYPTION_KEY=your_secret_encryption_key_min_32_characters_long

# Telegram API (для UserBot)
API_ID=your_api_id_here
API_HASH=your_api_hash_here
PHONE_NUMBER=+7xxxxxxxxxx

# Каналы
CHANNEL_ID=-100xxxxxxxxxx
PARSE_CHANNEL_ID=-100xxxxxxxxxx

# Admin ID (для первоначальной настройки администратора)
ADMIN_ID=your_telegram_id
